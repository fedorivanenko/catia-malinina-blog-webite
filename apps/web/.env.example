# Use a Resend API key with full access; sending-only keys cannot manage contacts.
RESEND_API_KEY=

# Create a Resend Segment (for example, "Catia Malinina Blog Subscribers")
# and use its ID to label subscribers for future Broadcasts.
RESEND_SEGMENT_ID=

# Published Resend Template sent after a new or reactivated subscription.
RESEND_WELCOME_TEMPLATE_ID=thanks-for-the-sub
CONTACT_FROM_EMAIL="Catia Malinina <hello@notification.fedor.studio>"
